# LINE Developers（LIFF）
NEXT_PUBLIC_LIFF_ID=

# ID トークン検証用チャネル ID（サーバーのみ）
LINE_LOGIN_CHANNEL_ID=

# Netlify のサイト URL（任意・metadataBase）
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# ===== コミュニケーションブリッジカレンダー（社内共通メニュー）=====
# @pocket アプリ名: コミュニケーションブリッジカレンダー
# COMMUNICATION_BRIDGE_CALENDAR_APP_ID=168  # 未設定時はアプリ名から自動取得（APIキー必須）
# COMMUNICATION_BRIDGE_CALENDAR_RESPONSE_CACHE_SECONDS=120
# COMMUNICATION_BRIDGE_CALENDAR_RECORDS_CACHE_SECONDS=300
# COMMUNICATION_BRIDGE_CALENDAR_MAX_PAGES=15
# COMMUNICATION_BRIDGE_CALENDAR_1=  読取①（必須）
# COMMUNICATION_BRIDGE_CALENDAR_2=  読取②
# COMMUNICATION_BRIDGE_CALENDAR_3=  更新③（書込時）
# COMMUNICATION_BRIDGE_CALENDAR_4= … _7  一覧サブ（429 分散・任意）
# COMMUNICATION_BRIDGE_CALENDAR_ATTACHMENT_FIELD_ID=  # 未設定時は「添付ファイル」列
# COMMUNICATION_BRIDGE_CALENDAR_START_DATE_FIELD_ID=  # 未設定時は「日付」列

# --- @pocket ---
ATPOCKET_DOMAIN=
# ATPOCKET_AUTH_HEADER=X-At-Pocket-Token

# 429 対策: @pocket の API 上限は「APIキーごと・100秒あたり」。
# サブキーが 429 のときは次のキーへ自動切替（LIST_4 … LIST_13 = 追加10本）。
# スタッフ名簿は ATPOCKET_API_KEY / _1 に加え _3 … _12（名簿読取専用・_2 は更新用）。
# 工事・お客様情報などは各アプリ用の *_ATPOCKET_API_KEY を個別に設定する。
#
# ===== スタッフ名簿 =====
# ATPOCKET_API_KEY   … 読取① 名簿一覧・勤務場所・PIN照会
# ATPOCKET_API_KEY_1 … 読取② AP/CL担当者・工事対応者リスト
# ATPOCKET_API_KEY_2 … 更新③ LINE紐付け・PIN設定
# ATPOCKET_API_KEY_3 … ATPOCKET_API_KEY_12  … 読取サブ（429 フェイルオーバー・名簿権限のみ）
ATPOCKET_API_KEY=
ATPOCKET_API_KEY_1=
ATPOCKET_API_KEY_2=
# ATPOCKET_API_KEY_3=
# ATPOCKET_API_KEY_4=
# ATPOCKET_API_KEY_5=
# ATPOCKET_API_KEY_6=
# ATPOCKET_API_KEY_7=
# ATPOCKET_API_KEY_8=
# ATPOCKET_API_KEY_9=
# ATPOCKET_API_KEY_10=
# ATPOCKET_API_KEY_11=
# ATPOCKET_API_KEY_12=
# 従来名（上書き用・任意）: STAFF_READ_ATPOCKET_API_KEY / STAFF_READ_ATPOCKET_API_KEY_1 / STAFF_WRITE_ATPOCKET_API_KEY
#
# ===== 工事カレンダー（各3キー必須）=====
# CALENDAR_ATPOCKET_API_KEY=    読取① 月一覧
# CALENDAR_ATPOCKET_API_KEY_1=  読取② fields 等
# CALENDAR_ATPOCKET_API_KEY_2=  更新③ 空枠・新規登録
#
# ===== お客様情報（各3キー必須）=====
# CUSTOMER_INFO_ATPOCKET_API_KEY=    読取① CRM・単票GET
# CUSTOMER_INFO_ATPOCKET_API_KEY_1=  読取② 検索・未入力一覧
# CUSTOMER_INFO_ATPOCKET_API_KEY_2=  更新③ PUT・工事連携登録
#
# ===== 勤怠（各3キー必須・ATTENDANCE_APP_ID 登録時）=====
# ATTENDANCE_APP_ID=
# ATTENDANCE_ATPOCKET_API_KEY=    読取① 当日ステータス
# ATTENDANCE_ATPOCKET_API_KEY_1=  読取② fields 等
# ATTENDANCE_ATPOCKET_API_KEY_2=  更新③ 出勤・退勤打刻
# 列 uniqueId（見出しと一致させる・自動判定より優先）
# ATTENDANCE_STAFF_NAME_FIELD_ID=  # 社員名
# ATTENDANCE_DATE_FIELD_ID=        # 勤怠日
# ATTENDANCE_CLOCK_IN_FIELD_ID=    # 出勤時刻
# ATTENDANCE_CLOCK_OUT_FIELD_ID=   # 退勤時間
# ATTENDANCE_MAX_PAGES=1           # 一覧の最大ページ（既定1・100件/ページ）
# ATTENDANCE_STATUS_CACHE_TTL_MS=60000  # サーバー側キャッシュ（ms・既定60秒）
# ATTENDANCE_ROSTER_MAX_PAGES=2        # 本日出勤者一覧の最大ページ（1ページ100件・既定2）

# ===== 稼働終了報告（社内共通メニュー・STAFF_APP_ID 必須）=====
# 報告時に「稼働」→ 下記ラベルへ更新（稼働状況・AP/CL稼働・工事対応稼働のうち稼働中の列のみ）
# WORK_END_INACTIVE_LABEL=非稼働

# ===== 取引先・商品一覧（各3キー必須）=====
# TRADING_PARTNER_ATPOCKET_API_KEY= / _1 / _2
# PRODUCT_CATALOG_ATPOCKET_API_KEY= / _1 / _2
#
# ===== ログ（更新③のみ必須・LOG_APP_ID 登録時）=====
# LOG_ATPOCKET_API_KEY_2=  （従来名 LOG_ATPOCKET_API_KEY も可）

STAFF_APP_ID=
LOG_APP_ID=

# フィールド識別名（Web API の uniqueId。例: field_101）
STAFF_NAME_FIELD_ID=
# LINE 紐付けの名前一覧用（見出し「稼働状況」。未設定時は見出し名で解決）
# STAFF_AVAILABILITY_FIELD_ID=
# 上記で一覧に出す値（未設定時は STAFF_CONSTRUCTION_AVAILABILITY_ACTIVE_LABEL または「稼働」）
# STAFF_AVAILABILITY_ACTIVE_LABEL=
# お客様情報の AP/CL所属支店自動入力用（見出し「勤務場所」。未設定時は見出し名で解決）
# STAFF_WORKPLACE_FIELD_ID=
# 勤怠の「本日の出勤者」部署表示用（見出し「部署」。未設定時は勤務場所列へフォールバック）
# STAFF_DEPARTMENT_FIELD_ID=

# 工事対応者リスト用：スタッフ名簿の「工事対応稼働状況」フィールド uniqueId（工事対応者をスタッフ名簿から選ぶとき必須）
# STAFF_CONSTRUCTION_AVAILABILITY_FIELD_ID=
# 上記で「一覧に出す」値（未設定時は「稼働」と NFKC 一致）
# STAFF_CONSTRUCTION_AVAILABILITY_ACTIVE_LABEL=

# 工事→お客様情報連携時、同一 T番号の既存行を探す最大ページ数（1ページ1000件・未設定時25）
# CUSTOMER_INFO_KEY_LOOKUP_MAX_PAGES=25

# お客様情報の AP/CL担当者リスト用（見出し「AP稼働状況」「CL稼働状況」。未設定時は見出し名で解決）
# STAFF_AP_AVAILABILITY_FIELD_ID=
# STAFF_CL_AVAILABILITY_FIELD_ID=
# AP/CL の「稼働」判定ラベル（未設定時は STAFF_CONSTRUCTION_AVAILABILITY_ACTIVE_LABEL または「稼働」）
# STAFF_AP_CL_AVAILABILITY_ACTIVE_LABEL=

# 取込キー「社員ID」列のフィールド識別名（スタッフレコード紐付け API 等・同名社員の区別表示にも利用）
# STAFF_IMPORT_KEY_FIELD_ID=
# GET が別キーでしか返さないときの値の取り元（カンマ区切り）
# STAFF_IMPORT_KEY_SOURCE_FIELD_IDS=
# PUT で必ず含める識別子（カンマ）。field-1 のみ書けば取込キーを field-1 とみなす（管理画面と同じ構成向け）
# 複数列があるときは syain_name,field-3,... のように並べ可能（先頭が field-* 以外ならそれを取込キー宛先に）
# STAFF_BIND_ALWAYS_INCLUDE_FIELD_IDS=

# スタッフ名簿の LINE ユーザーID（①・②とも必須・@pocket GET .../fields の uniqueId）
# 照合・紐付け・AP/CL初期値は①②のどちらかに ID トークンの sub（U…）があれば一致
# 推奨（見出しと対応しやすい）:
STAFF_LINE_USER_ID_1_FIELD_ID=
STAFF_LINE_USER_ID_2_FIELD_ID=
# 後方互換（①=_FIELD_ID、②=_FIELD_ID_2）:
# STAFF_LINE_USER_ID_FIELD_ID=
# STAFF_LINE_USER_ID_FIELD_ID_2=

# 営業ダッシュボード（PT集計表 ranking_pt_dashboard.js 相当）
# SALES_DASHBOARD_PT_APP_ID=          # ※直接入力禁止　PT集計表 の appsId（必須）
# 読取①②③（従来）に加え、429 分散用サブキー LIST_1 … LIST_13（LIST_4〜13 = 追加10本）
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY=         読取①
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_1=       読取②
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_2=       読取③
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_FIELDS=  fields 専用（推奨・読取①と分離）
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_LIST_1=  一覧サブ①
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_LIST_2=  一覧サブ②
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_LIST_3=  一覧サブ③
# SALES_DASHBOARD_PT_ATPOCKET_API_KEY_LIST_4=  … LIST_13 まで（429 時に順次切替）
# SALES_DASHBOARD_CONTRACT_APP_ID=    # 契約件数用（未設定時は CUSTOMER_INFO_APP_ID）
# PT集計表の uniqueId（見出しと一致させる・自動判定より優先）
# SALES_DASHBOARD_PT_SALESPERSON_FIELD_ID=   # 担当者名
# SALES_DASHBOARD_PT_DATE_FIELD_ID=         # PT加算日（月別集計に使用・必須推奨）
# SALES_DASHBOARD_PT_PT_FIELD_ID=            # PT
# SALES_DASHBOARD_PT_SALES_FIELD_ID=
# SALES_DASHBOARD_CONTRACT_DATE_FIELD_ID=
# SALES_DASHBOARD_CONTRACT_CL_FIELD_ID=
# SALES_DASHBOARD_CONTRACT_STATUS_FIELD_ID=
# SALES_DASHBOARD_APO_APP_ID=          # アポ取得情報連携 の appsId（アポ件数・商談進捗情報）
# MEETING_SCHEDULE_CL_PERSON_FIELD_ID=  # CL担当者（未設定時は見出し「CL担当者」）
# MEETING_SCHEDULE_DATE_FIELD_ID=        # 商談日（未設定時は「商談・資料送付予定日時」）
# MEETING_SCHEDULE_MEETING_DATE_FIELD_ID= # 初回商談実施日（返待ち・再商談の日付判定用）
# MEETING_SCHEDULE_RESPONSE_DATE_FIELD_ID= # 返待ち回答日
# MEETING_SCHEDULE_STATUSES=             # 対象見積ステータス（カンマ区切り・省略時は新規/見積依頼済み/見積依頼済（資料のみ）/商談日調整中/商談セット作成済み/再商談日調整中/資料送付済/再商談/返待ち）
# MEETING_SCHEDULE_EXCLUDED_STATUSES=    # 除外ステータス（カンマ区切り・省略時：再商談否/成約、返待ち否/成約）
# MEETING_SCHEDULE_EDITABLE_STATUSES=    # LIFFから変更可能な見積ステータス（カンマ区切り・省略時は表示対象+成約/否系）
# MEETING_SCHEDULE_IMPORT_KEY_FIELD_ID=  # 取込キー（アポ通番(仮)）。省略時は見出しから自動解決
# MEETING_SCHEDULE_IMPORT_KEY_SOURCE_FIELD_IDS= # 取込キー読取の追加列（カンマ区切り・任意）
# MEETING_SCHEDULE_CLOSE_TYPE_FIELD_ID=   # 片クロor両クロ（省略時は見出しから自動解決）
# MEETING_SCHEDULE_CLOSE_TYPE_OPTIONS=   # 片クロ,両クロ
# MEETING_SCHEDULE_MEETING_PLACE_OPTIONS= # 宅内テーブル商談,宅内玄関商談,宅外商談,オンライン商談 など
# SALES_DASHBOARD_APO_ATPOCKET_API_KEY=         読取①
# SALES_DASHBOARD_APO_ATPOCKET_API_KEY_1=       読取②
# SALES_DASHBOARD_APO_ATPOCKET_API_KEY_2=       更新③（見積ステータス・商談・資料送付予定日時の変更に必要）
# SALES_DASHBOARD_APO_ATPOCKET_API_KEY_FIELDS=  fields 専用（推奨）
# SALES_DASHBOARD_APO_ATPOCKET_API_KEY_LIST_1= … LIST_13 まで（429 時に順次切替）
# 契約件数（お客様情報アプリ）— 顧客一覧と分離するダッシュボード専用サブキー
# CUSTOMER_INFO_ATPOCKET_API_KEY_DASHBOARD_FIELDS=
# CUSTOMER_INFO_ATPOCKET_API_KEY_DASHBOARD_LIST_1= … DASHBOARD_LIST_13 まで
# CUSTOMER_INFO_ATPOCKET_API_KEY_LIST_1= … CUSTOMER_INFO_ATPOCKET_API_KEY_LIST_13 まで
# SALES_DASHBOARD_APO_SALESPERSON_FIELD_ID=
# SALES_DASHBOARD_APO_TYPE_FIELD_ID=
# SALES_DASHBOARD_APO_DATE_FIELD_ID=
# SALES_DASHBOARD_APO_STATUS_FIELD_ID=
# SALES_DASHBOARD_APO_TYPE_FILTER_VALUES=ダイレクト,お客様紹介,(DC)工務店OBリスト
# アポ取得時入力（/apo-acquisition）
# APO_ACQUISITION_DATE_FIELD_ID=       # アポ取得日（未設定時は見出し「アポ取得日」）
# APO_ACQUISITION_ELEVATION_FLOOR_PLAN_FIELD_ID=  # 立面図・平面図（未設定時は見出し「立面図・平面図」）
# APO_ACQUISITION_DEFAULT_ESTIMATE_STATUS=新規
# APO_ACQUISITION_FIRST_MEETING_DATE_FIELD_ID=  # 初回商談予定日（未設定時は見出し「初回商談予定日」。新規登録時に商談・資料送付予定日時から自動反映）
# APO_ACQUISITION_APO_TYPE_OPTIONS=ダイレクト,お客様紹介,(DC)工務店OBリスト,ソーラーパートナーズ
# APO_ACQUISITION_PHONE_FIELD_ID=
# APO_ACQUISITION_MEMO_FIELD_ID=
# レコード走査の最大ページ数（1ページ1000件・既定25）
# SALES_DASHBOARD_MAX_PAGES=25
# 営業ダッシュボード完成 JSON のサーバーキャッシュ（秒・既定 180・40名同時アクセス向け）
# SALES_DASHBOARD_CACHE_SECONDS=300

LOG_FIELD_LINE_USER_ID=
LOG_FIELD_STAFF_NAME=
LOG_FIELD_CUSTOMER_NAME=
LOG_FIELD_CONTENT=

# LOG_FIELD_STAFF_RECORD_ID=

# --- 工事カレンダー（任意・CALENDAR_APP_ID 設定時のみ API が応答） ---
# @pocket 429 対策: 同一月の完成 JSON をサーバーでキャッシュ（秒・30〜600、既定 120）
# CALENDAR_RESPONSE_CACHE_SECONDS=120
# 工事一覧・工事報告の中間キャッシュ（秒・既定 300 / 1800）
# CALENDAR_CONSTRUCTION_CACHE_SECONDS=300
# CALENDAR_REPORT_CACHE_SECONDS=1800
# CALENDAR_CONSTRUCTION_MAX_PAGES=15
# CALENDAR_REPORT_MAX_PAGES=30
# true で一覧APIを表示月と重なるレコードに限定（読込高速化・レート抑制）。異常時は false
# CALENDAR_RECORDS_QUERY_FILTER=true
# 新規作成 API はサブキー2側のキーがレコード登録可能であること（T番号は送らず自動採番）
# CALENDAR_APP_ID=
# 施工業者（カレンダー表示・チップ左縞の色・2行目の「施工:」）。既定は工事アプリのフィールド見出しから自動推定。
# 見出しが一致しない／複数候補で誤るときのみ @pocket GET .../fields の uniqueId を設定（例: field-12）。
# CALENDAR_CONTRACTOR_FIELD_ID=
# 施工予定日・新築4日程の列（uniqueId）。既定は見出し「施工予定日」「仕込日」「パネル工事日」「電気工事日」「アプリ設定日」で自動推定。
# 見出しが違う／同日空枠の自動削除が「reason: no_candidate」のまま動かない場合に明示指定する。
# CALENDAR_START_DATE_FIELD_ID=          # 施工予定日（同日空枠削除の基準日。最重要）
# CALENDAR_SHIGUMI_DATE_FIELD_ID=        # 仕込日
# CALENDAR_PANEL_WORK_DATE_FIELD_ID=     # パネル工事日
# CALENDAR_ELECTRIC_WORK_DATE_FIELD_ID=  # 電気工事日
# CALENDAR_APP_SETTINGS_DATE_FIELD_ID=   # アプリ設定日
# CALENDAR_ATPOCKET_API_KEY=
# CALENDAR_ATPOCKET_API_KEY_1=
# CALENDAR_ATPOCKET_API_KEY_2=
# CALENDAR_ATPOCKET_API_KEY_LIST_1= … LIST_13 まで（429 時に順次切替）
# 従来の CALENDAR_WRITE_ATPOCKET_API_KEY は _2 の上書き用（任意）
# 工事空枠入力の書き込み先（必須・@pocket Web API のフィールド uniqueId）
# CALENDAR_EMPTY_FILL_CUSTOMER_NAME_FIELD_ID=
# CALENDAR_EMPTY_FILL_HOUSING_STATUS_FIELD_ID=
# T番号（必須・空枠更新はお客様名・住宅ステータス・T番号＋任意で工事対応者）
# CALENDAR_EMPTY_FILL_TNUMBER_FIELD_ID=
# 工事対応者（単一選択・スタッフ名簿から「工事対応稼働＝稼働」の社員名をドロップダウン表示）。工事アプリ側フィールドの uniqueId（推奨）
# CALENDAR_EMPTY_FILL_CONSTRUCTION_HANDLER_FIELD_ID=
# 後方互換名（未設定時のみ読み込み）
# CALENDAR_EMPTY_FILL_CONSTRUCTION_REGISTRANT_FIELD_ID=
# お客様名フィールドの別名（後方互換・任意）
# CALENDAR_EMPTY_FILL_TITLE_FIELD_ID=
# 工事報告アプリ（T番号突合・✅表示）。任意
# CALENDAR_REPORT_APP_ID=
# CALENDAR_REPORT_ATPOCKET_API_KEY= / _1 / _2（未設定時は CALENDAR_ATPOCKET_API_KEY_1）
# 工事登録（空枠・新規）後に、工事レコードのユニークキー（既定 T番号）をお客様情報アプリへ 1 件登録する
# CUSTOMER_INFO_APP_ID=
# CUSTOMER_INFO_ATPOCKET_API_KEY_2=    # お客様情報アプリ用（必須のどちらか）
# CUSTOMER_INFO_ATPOCKET_API_KEY=      # 従来名・そのまま利用可
# お客様情報アプリ側：工事のユニークキー（T番号）を入れるフィールド uniqueId（連携・更新時の取込キー）
# CUSTOMER_INFO_CONSTRUCTION_UNIQUE_KEY_FIELD_ID=
# T番号が GET で field-数字 のみ返る場合の読み取り元（カンマ区切り・任意）
# CUSTOMER_INFO_IMPORT_KEY_SOURCE_FIELD_IDS=
# お客様情報アプリ側：お客様名（検索・表示用。お客様情報入力で必須）
# CUSTOMER_INFO_CUSTOMER_NAME_FIELD_ID=
# 工事→お客様情報連携：登録番号の転記先（未設定時は見出し「APPT登録番号」「CLPT登録番号」）
# CUSTOMER_INFO_APPT_REGISTRATION_NUMBER_FIELD_ID=
# CUSTOMER_INFO_CLPT_REGISTRATION_NUMBER_FIELD_ID=
# 工事→お客様情報連携：施工業者・施工予定日の転記先（未設定時は見出しで解決）
# CUSTOMER_INFO_CONSTRUCTION_CONTRACTOR_FIELD_ID=
# CUSTOMER_INFO_FIRST_CONSTRUCTION_DATE_FIELD_ID=  # 初回施工予定日
# CUSTOMER_INFO_CONSTRUCTION_DATE_FIELD_ID=        # 施工予定日
# お客様情報入力：検索結果の補足表示（未設定時は工事ユニークキー列を使用）
# CUSTOMER_INFO_SUBTITLE_FIELD_ID=
# 担当顧客一覧・キャンセル判定（uniqueId 指定推奨・書類未回収からキャンセル案件を除外）
# CUSTOMER_INFO_CUSTOMER_STATUS_FIELD_ID=
# お客様情報入力：旧方式のみ（設定すると組み込みフォーム PT・設置種別 等は無効）
# CUSTOMER_INFO_EDITABLE_FIELD_IDS=
# 列見出しと uniqueId が一致しない列（例: CUSTOMER_INFO_FIELD_PT=field-12）
# CUSTOMER_INFO_FIELD_PT=
# CUSTOMER_INFO_FIELD_AP_STAFF=
# CUSTOMER_INFO_FIELD_AP_BRANCH=
# CUSTOMER_INFO_FIELD_CL_BRANCH=
# CUSTOMER_INFO_FIELD_BATTERY_MODEL_1=  # 蓄電池品番①（自動転記・フォーム非表示）
# CUSTOMER_INFO_FIELD_BATTERY_MODEL_2=  # 蓄電池品番②
# 列見出しと uniqueId が一致しない列（例）
# CUSTOMER_INFO_FIELD_POSTAL_CODE=   # 郵便番号（都道府県列と取り違えないよう uniqueId を明示推奨）
# CUSTOMER_INFO_FIELD_PREFECTURE=
# CUSTOMER_INFO_FIELD_CITY=
# CUSTOMER_INFO_FIELD_ADDRESS=
# CUSTOMER_INFO_FIELD_PANEL_CAPACITY_KW=  # 太陽光パネル容量(kW)・uniqueId 明示推奨（例: field-42）
# CUSTOMER_INFO_FIELD_REFERRAL_FEE=  # 紹介手数料
# CUSTOMER_INFO_FIELD_PAYMENT_METHOD=
# CUSTOMER_INFO_FIELD_LOAN_PAPER=
# CUSTOMER_INFO_FIELD_GROUP_CREDIT_LIFE_INSURANCE=
# CUSTOMER_INFO_FIELD_SALES_CONSTRUCTION_CONTRACT=
# CUSTOMER_INFO_FIELD_POWER_COMPANY_FORM=
# CUSTOMER_INFO_FIELD_CONTRACT_POWER_COMPANY=  # 契約電力会社名
# CUSTOMER_INFO_FIELD_CONTRACT_POWER_PLAN=      # 契約電力プラン
# CUSTOMER_INFO_FIELD_FEED_IN_BANK_ACCOUNT_FORM=
# CUSTOMER_INFO_FIELD_VICINITY_SKETCH_MAP=
# CUSTOMER_INFO_FIELD_POWER_OF_ATTORNEY_STORAGE=
# CUSTOMER_INFO_FIELD_POWER_OF_ATTORNEY_CHANGE_CERT=
# CUSTOMER_INFO_FIELD_POWER_OF_ATTORNEY_ID_PASSWORD=
# CUSTOMER_INFO_FIELD_EQUIPMENT_CERT_CONSENT=
# CUSTOMER_INFO_FIELD_OPERATING_COST_REPORT_CONSENT=
# CUSTOMER_INFO_FIELD_PERSONAL_INFO_CONSENT=
# CUSTOMER_INFO_FIELD_FREE_USE_GENERATION_CONSENT=
# CUSTOMER_INFO_FIELD_SEAL_REGISTRATION_CERTIFICATE=
# CUSTOMER_INFO_FIELD_REGISTRY_BOOK=
# CUSTOMER_INFO_FIELD_SUBSIDY_PRE_APPLICATION_DOCS=
# CUSTOMER_INFO_FIELD_SUBSIDY=   # 見出し「補助金有無」
# CUSTOMER_INFO_FIELD_PRE_APPLICATION=  # 見出し「事前申請有無」
# PT 転記先（列見出し CLPT / APPT と一致させる。未設定時は見出し名で解決）
# CUSTOMER_INFO_FIELD_CLPT=
# CUSTOMER_INFO_FIELD_APPT=
# お客様情報入力：検索の最大ページ数・最大件数（任意）
# CUSTOMER_INFO_SEARCH_MAX_PAGES=20
# CUSTOMER_INFO_SEARCH_MAX_RESULTS=50
# トップ「続きを入力」・未入力一覧（入力ステータス未入力＋担当者/作成者一致。作成日列は不要）
# CUSTOMER_INFO_CONTINUE_STATUS_FIELD_ID=  # 未設定時は「入力ステータス」。列が無い場合は必須未入力で判定
# CUSTOMER_INFO_CONTINUE_STATUS_VALUES=未入力
# CUSTOMER_INFO_CONTINUE_MAX_PAGES=12
# CUSTOMER_INFO_CONTINUE_MAX_RESULTS=8
# 工事連携時に LINE 紐付け担当者名を転記（見出し「案件作成者」を優先して解決）
# CUSTOMER_INFO_CREATOR_FIELD_ID=
# パフォーマンス（@pocket API 呼び出し削減・429 回避）
# スタッフ名簿のサーバーキャッシュ（既定 1800000=30分・最大1時間）。429 時は最大100秒は再取得しない
# STAFF_ROSTER_CACHE_TTL_MS=1800000
# 名簿の最大取得ページ数（1ページ1000件・既定10）。429 抑制のため全ページ取得はしない
# STAFF_ROSTER_MAX_PAGES=10
# TTL 切れ後もこの間隔（ms）以内は再取得しない（既定 120000=2分）
# STAFF_ROSTER_MIN_REFETCH_MS=120000
# 4桁PINロック（スタッフ名簿: PINコード / リセット認証コード / リセット承認フラグ）
# STAFF_PIN_LOCK_DISABLED=true で無効化
# STAFF_PIN_CODE_FIELD_ID=
# STAFF_PIN_RESET_CODE_FIELD_ID=
# STAFF_PIN_RESET_APPROVAL_FIELD_ID=
# CUSTOMER_INFO_PENDING_CACHE_TTL_MS=45000
# CUSTOMER_INFO_KEY_LOOKUP_CACHE_TTL_MS=120000
# 担当顧客一覧（CRM）: 一覧の最大ページ数・件数、列の上書き（未設定時は見出しで解決）
# CUSTOMER_CRM_MAX_PAGES=25
# CUSTOMER_CRM_MAX_RESULTS=80
# CUSTOMER_INFO_CONSTRUCTION_DATE_FIELD_ID=  # 施工予定日（お客様情報入力・CRM 共通。上記連携用と同一で可）
# CUSTOMER_INFO_SUBSIDY_FIELD_ID=             # 補助金有無（CRM・一覧バッジ。未設定時は見出し「補助金有無」）
# CUSTOMER_INFO_SUBSIDY_USAGE_FIELD_ID=       # 上記の別名（後方互換）
# CUSTOMER_INFO_UPDATED_DATE_FIELD_ID=       # 一覧の並び順（見出し「更新日」「最終更新日」等）
# 取引先会社一覧（お客様情報メーカー・信販、工事カレンダー新規登録の施工会社など）
# お客様情報「メーカー」選択肢：会社種別=メーカー・取引状況=取引中
# 工事カレンダー「新規登録」施工会社：会社種別=施工店・取引状況=取引中
# TRADING_PARTNER_APP_ID=
# TRADING_PARTNER_ATPOCKET_API_KEY=
# TRADING_PARTNER_ATPOCKET_API_KEY_1=
# TRADING_PARTNER_ATPOCKET_API_KEY_2=
# TRADING_PARTNER_COMPANY_TYPE_FIELD_ID=  # 未設定時は見出し「会社種別」
# TRADING_PARTNER_TRADE_STATUS_FIELD_ID=  # 未設定時は見出し「取引状況」
# TRADING_PARTNER_COMPANY_NAME_FIELD_ID=  # 未設定時は見出し「取引会社名」
# お客様情報「パネル品番」：商品一覧(型番詳細)（メーカー名一致・商品種別=太陽光パネル・ステータス=現行の型番）
# PRODUCT_CATALOG_APP_ID=
# PRODUCT_CATALOG_ATPOCKET_API_KEY=
# PRODUCT_CATALOG_ATPOCKET_API_KEY_1=
# PRODUCT_CATALOG_ATPOCKET_API_KEY_2=
# PRODUCT_CATALOG_MANUFACTURER_NAME_FIELD_ID=  # 見出し「メーカー名」
# PRODUCT_CATALOG_PRODUCT_TYPE_FIELD_ID=      # 見出し「商品種別」
# PRODUCT_CATALOG_STATUS_FIELD_ID=            # 見出し「ステータス」
# PRODUCT_CATALOG_MODEL_NUMBER_FIELD_ID=      # 見出し「型番」（パネル・パワコン）
# PRODUCT_CATALOG_OUTPUT_OR_CAPACITY_FIELD_ID=  # 見出し「出力または容量」（蓄電池容量）
# 工事アプリ側：ユニークキー列（未設定時は T番号＝CALENDAR_EMPTY_FILL_TNUMBER_FIELD_ID または見出し「T番号」）
# CALENDAR_CONSTRUCTION_UNIQUE_KEY_FIELD_ID=
# 工事→お客様情報連携：登録番号の取得元（未設定時は見出し「APPT登録番号」「CLPT登録番号」）
# CALENDAR_APPT_REGISTRATION_NUMBER_FIELD_ID=
# CALENDAR_CLPT_REGISTRATION_NUMBER_FIELD_ID=
# 追加で祝日扱いする日（カンマ区切り YYYY-MM-DD）
# CALENDAR_EXTRA_HOLIDAYS=
# CALENDAR_INCLUDE_SANDWICH_NATIONAL_HOLIDAY=true
